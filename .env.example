# OpenAI (needs GPT-Live alpha access on the account)
OPENAI_API_KEY=

# LiveKit project (LiveKit Cloud or self-hosted)
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# Postgres
POSTGRES_USER=receptionist
POSTGRES_PASSWORD=receptionist
POSTGRES_DB=receptionist
POSTGRES_PORT=5432
# App DB access (SQLAlchemy async driver)
DATABASE_URL=postgresql+asyncpg://receptionist:receptionist@localhost:5432/receptionist
# LangGraph checkpointer access (psycopg driver, same physical DB)
CHECKPOINTER_DATABASE_URL=postgresql://receptionist:receptionist@localhost:5432/receptionist

# Agent persona (spoken name only -- lab name/address/phone/hours live in the lab_info table)
AGENT_NAME=Sara

# GPT-Live's backend reasoning model -- picks tools, drives conversation logic.
# The voice/speech layer itself is always gpt-live-1, set separately in agent.py.
REASONING_MODEL=gpt-5.1

# Worker log level. "dev" mode defaults to DEBUG if unset, which is noisy
# enough to backpressure run.py's piped output and delay responses/transcription.
# One of TRACE/DEBUG/INFO/WARN/ERROR/CRITICAL.
LOG_LEVEL=WARN

# Token server (browser demo)
TOKEN_SERVER_HOST=0.0.0.0
TOKEN_SERVER_PORT=8080

# --- Real phone line (SIP) -- not required for the browser demo ---
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_TRUNK_SID=
# LIVEKIT_SIP_TRUNK_ID=
# LIVEKIT_SIP_DISPATCH_RULE_ID=
# LAB_PHONE_NUMBER=
